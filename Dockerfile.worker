FROM eclipse-temurin:21-jdk-jammy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl git python3 python3-pip && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends gh && \
    pip3 install --no-cache-dir mcp-atlassian==0.21.1 && \
    npm install -g @anthropic-ai/claude-code@2.1.139 && \
    rm -rf /var/lib/apt/lists/*

ENV DISABLE_AUTOUPDATER=1
ENV PYTHONUNBUFFERED=1

RUN useradd -m -s /bin/bash agent
USER agent
WORKDIR /home/agent

# Pre-bake the Gradle wrapper distribution so workers don't download it at runtime.
# Copy the wrapper files, run ./gradlew --version to trigger download + extraction
# into the correct hash-based directory structure, then remove the wrapper files.
COPY --chown=agent:agent gradlew gradlew
COPY --chown=agent:agent gradle/wrapper gradle/wrapper
RUN chmod +x gradlew && ./gradlew --version --no-daemon && rm -f gradlew && rm -rf gradle

COPY --chown=agent:agent agent/worker-entrypoint.sh entrypoint.sh
RUN chmod +x entrypoint.sh

ENTRYPOINT ["./entrypoint.sh"]
