FROM eclipse-temurin:21-jdk-jammy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl git python3 && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends gh && \
    npm install -g @anthropic-ai/claude-code@2.1.139 && \
    rm -rf /var/lib/apt/lists/*

ENV DISABLE_AUTOUPDATER=1
ENV PYTHONUNBUFFERED=1

RUN useradd -m -s /bin/bash agent
USER agent
WORKDIR /home/agent

# Pre-bake the Gradle distribution and JVM module dependencies into the image layer
# at build time. Covers :agentruntime and :appServer only.
#
# :composeApp and :shared are excluded because:
#   - run-affected-tests.sh explicitly skips both (no Android/iOS SDK in Cloud Run)
#   - :composeApp/:shared dependency resolution downloads kotlin-native-prebuilt (~245 MB)
#     which is never used at worker runtime
#
# At runtime the worker makes zero Gradle downloads for :agentruntime/:appServer;
# everything resolves from the image layer on the local container filesystem.
COPY --chown=agent:agent gradlew gradlew
COPY --chown=agent:agent gradle/ gradle/
COPY --chown=agent:agent gradle.properties gradle.properties
COPY --chown=agent:agent settings.gradle.kts settings.gradle.kts
COPY --chown=agent:agent build.gradle.kts build.gradle.kts
COPY --chown=agent:agent agentruntime/build.gradle.kts agentruntime/build.gradle.kts
COPY --chown=agent:agent appServer/build.gradle.kts appServer/build.gradle.kts
COPY --chown=agent:agent composeApp/build.gradle.kts composeApp/build.gradle.kts
COPY --chown=agent:agent shared/build.gradle.kts shared/build.gradle.kts
RUN chmod +x gradlew && \
    ./gradlew help --no-daemon && \
    ./gradlew :agentruntime:dependencies :appServer:dependencies \
        --no-daemon --configure-on-demand && \
    rm -f gradlew && rm -rf gradle

COPY --chown=agent:agent agentruntime/entrypoint-common.sh entrypoint-common.sh
COPY --chown=agent:agent agentruntime/worker-entrypoint.sh entrypoint.sh
COPY --chown=agent:agent agentruntime/get-github-token.py get-github-token.py
RUN chmod +x entrypoint.sh

ENTRYPOINT ["./entrypoint.sh"]
