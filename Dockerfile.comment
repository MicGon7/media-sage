FROM alpine:3.21

SHELL ["/bin/sh", "-o", "pipefail", "-c"]

RUN apk add --no-cache \
    bash \
    curl \
    git \
    nodejs \
    npm \
    openssl \
    python3 \
    py3-pip \
    && npm install -g @anthropic-ai/claude-code@2.1.139 \
    && apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community github-cli

ENV DISABLE_AUTOUPDATER=1
ENV PYTHONUNBUFFERED=1

RUN adduser -D -s /bin/bash agent
USER agent
WORKDIR /home/agent

COPY --chown=agent:agent agent/comment-entrypoint.sh entrypoint.sh
COPY --chown=agent:agent agent/get-github-token.py get-github-token.py
COPY --chown=agent:agent .claude/commands/ /home/agent/.claude/commands/
RUN chmod +x entrypoint.sh

ENTRYPOINT ["./entrypoint.sh"]
