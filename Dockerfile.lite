FROM alpine:3.21

SHELL ["/bin/sh", "-o", "pipefail", "-c"]

RUN apk add --no-cache \
    bash \
    curl \
    git \
    openssl \
    python3 \
    py3-pip \
    && apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community github-cli

ENV PYTHONUNBUFFERED=1

RUN adduser -D -s /bin/bash agent
USER agent
WORKDIR /home/agent

COPY --chown=agent:agent orchestrator/entrypoint-common.sh entrypoint-common.sh
COPY --chown=agent:agent orchestrator/lite-entrypoint.sh entrypoint.sh
COPY --chown=agent:agent orchestrator/get-github-token.py get-github-token.py
COPY --chown=agent:agent scripts/ /home/agent/scripts/
RUN chmod +x entrypoint.sh /home/agent/scripts/*.sh

ENTRYPOINT ["./entrypoint.sh"]
