FROM eclipse-temurin:21-jdk-jammy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl git python3 python3-pip && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends gh && \
    npm install -g @anthropic-ai/claude-code@2.1.139 && \
    rm -rf /var/lib/apt/lists/*

ENV DISABLE_AUTOUPDATER=1
ENV PYTHONUNBUFFERED=1

RUN useradd -m -s /bin/bash agent
USER agent
WORKDIR /home/agent

# Pre-bake the Gradle distribution, internal API jars, and all module dependencies
# into the image layer at build time. Covers :orchestrator, :appServer, :composeApp, and :shared.
#
# Why single-stage (no Android SDK or Kotlin/Native toolchain needed):
#   - AGP resolves :composeApp dependencies without the Android SDK at config time
#   - :shared has iosArm64/iosSimulatorArm64 targets but the dependencies task only
#     downloads the kotlin-native-prebuilt Maven artifact (~245 MB) to .gradle/caches;
#     it does NOT extract the 3 GB .konan toolchain directory
#   - At runtime, if Gradle needs to configure native targets it extracts from the
#     cached artifact (fast local I/O) rather than downloading over the network
#
# At runtime the worker makes zero Gradle downloads; everything resolves from
# the image layer on the local container filesystem.
COPY --chown=agent:agent gradlew gradlew
COPY --chown=agent:agent gradle/ gradle/
COPY --chown=agent:agent gradle.properties gradle.properties
COPY --chown=agent:agent settings.gradle.kts settings.gradle.kts
COPY --chown=agent:agent build.gradle.kts build.gradle.kts
COPY --chown=agent:agent orchestrator/build.gradle.kts orchestrator/build.gradle.kts
COPY --chown=agent:agent appServer/build.gradle.kts appServer/build.gradle.kts
COPY --chown=agent:agent composeApp/build.gradle.kts composeApp/build.gradle.kts
COPY --chown=agent:agent shared/build.gradle.kts shared/build.gradle.kts
RUN chmod +x gradlew && \
    ./gradlew help --no-daemon && \
    ./gradlew :orchestrator:dependencies :appServer:dependencies :composeApp:dependencies :shared:dependencies \
        --no-daemon --configure-on-demand && \
    rm -f gradlew && rm -rf gradle

COPY --chown=agent:agent orchestrator/entrypoint-common.sh entrypoint-common.sh
COPY --chown=agent:agent orchestrator/worker-entrypoint.sh entrypoint.sh
COPY --chown=agent:agent orchestrator/get-github-token.py get-github-token.py
RUN chmod +x entrypoint.sh

ENTRYPOINT ["./entrypoint.sh"]
